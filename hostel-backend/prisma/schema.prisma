generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hostel {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())

  rooms         Room[]
  users         User[]
  userHostels   UserHostel[]
  invites       Invite[]
  complaints    Complaint[]
  notifications Notification[]
  payments      Payment[]

  isDeleted     Boolean @default(false)
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  phone         String? @unique
  emailVerified Boolean @default(false)
  password      String?
  role          Role    @default(USER)

  hostelId String?
  roomId   String?

  createdAt DateTime @default(now())

  hostel Hostel? @relation(fields: [hostelId], references: [id])
  room   Room?   @relation(fields: [roomId], references: [id])
  bed    Bed?    @relation("UserBed")

  complaints             Complaint[]
  complaintComments      ComplaintComment[]
  monthlyFees            MonthlyFee[]
  payments               Payment[]
  notificationRecipients NotificationRecipient[]
  userHostels            UserHostel[]
  userDetails            UserDetails?
  profileUpdateRequests ProfileUpdateRequest[]
}

model UserDetails {
  id              String  @id @default(uuid())
  userId          String  @unique
  fatherName        String?
  fatherPhone       String?
  fatherProfession  String?
  motherName        String?
  motherPhone       String?
  motherProfession  String?
  parentAddress     String?
  permanentPhone    String?

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileUpdateRequest {
  id               String   @id @default(uuid())
  userId           String
  requestedChanges Json
  reason           String?
  status           UpdateStatus @default(PENDING)
  adminComment     String?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id        String   @id @default(uuid())
  roomNo    String
  capacity  Int
  hostelId  String
  createdAt DateTime @default(now())

  hostel Hostel @relation(fields: [hostelId], references: [id])

  beds  Bed[]
  users User[]

  @@unique([hostelId, roomNo]) // 🔥 IMPORTANT
}

model Bed {
  id     String  @id @default(uuid())
  bedNo  String
  roomId String
  userId String? @unique

  room Room  @relation(fields: [roomId], references: [id])
  user User? @relation("UserBed", fields: [userId], references: [id])

  @@unique([roomId, bedNo])
}

model MonthlyFee {
  id        String        @id @default(uuid())
  userId    String
  month     String
  amount    Int
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id])
  payment Payment?

  @@index([userId])
}

model Payment {
  id           String @id @default(uuid())
  userId       String
  monthlyFeeId String @unique
  amount       Int

  mode PaymentMode // CASH / ONLINE / UPI

  // 🔥 Razorpay fields (IMPORTANT)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // Status tracking
  status PaymentStatus @default(PENDING)

  // Manual payment fields
  transactionId      String?
  remarks            String?
  collectedByAdminId String?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  monthlyFee MonthlyFee @relation(fields: [monthlyFeeId], references: [id])
  hostelId   String?
  hostel     Hostel?    @relation(fields: [hostelId], references: [id])

  @@index([userId])
  @@index([hostelId])
}

model Complaint {
  id          String          @id @default(uuid())
  title       String
  description String
  status      ComplaintStatus @default(OPEN)
  userId      String
  hostelId    String
  createdAt   DateTime        @default(now())

  user     User               @relation(fields: [userId], references: [id])
  hostel   Hostel             @relation(fields: [hostelId], references: [id])
  comments ComplaintComment[]

  @@index([userId])
  @@index([hostelId])
}

model ComplaintComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  complaintId String
  userId      String

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  hostelId  String?
  createdAt DateTime @default(now())

  hostel     Hostel?                 @relation(fields: [hostelId], references: [id])
  recipients NotificationRecipient[]

  @@index([hostelId])
}

model NotificationRecipient {
  id             String  @id @default(uuid())
  notificationId String
  userId         String
  read           Boolean @default(false)

  notification Notification @relation(fields: [notificationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

model Food {
  id        String   @id @default(uuid())
  date      DateTime @unique
  createdAt DateTime @default(now())

  meals Meal[]
}

model Meal {
  id     String   @id @default(uuid())
  type   MealType
  foodId String

  food  Food       @relation(fields: [foodId], references: [id])
  items MealItem[]

  @@unique([foodId, type])
}

model MealItem {
  id     String @id @default(uuid())
  name   String
  mealId String

  meal Meal @relation(fields: [mealId], references: [id])

  @@index([mealId])
}

model UserHostel {
  id       String     @id @default(uuid())
  userId   String
  hostelId String
  role     HostelRole

  user   User   @relation(fields: [userId], references: [id])
  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@unique([userId, hostelId])
  @@index([hostelId])
}

enum InviteType {
  EMAIL
  OPEN
}

model Invite {
  id        String     @id @default(uuid())
  email     String?
  code      String     @unique
  role      HostelRole
  type      InviteType
  hostelId  String
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@index([email])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum HostelRole {
  ADMIN
  STUDENT
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum PaymentMode {
  ONLINE
  CASH
  UPI
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum UpdateStatus {
  PENDING
  APPROVED
  REJECTED
}
